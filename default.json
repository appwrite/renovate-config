{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Appwrite shared Renovate preset. Renovate owns dependency PRs; Dependabot only raises alerts.",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "group:allNonMajor",
    ":semanticCommits"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Tags look like php-8.5-2.1.4, which Docker versioning rejects, so the image would never update.",
      "matchPackageNames": ["appwrite/utopia-base"],
      "versioning": "regex:^(?<compatibility>php-\\d+\\.\\d+)-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "A floating base image such as debian:trixie-slim gets OS fixes under the same tag, so only a digest shows that a rebuild is due.",
      "matchManagers": ["dockerfile"],
      "pinDigests": true
    },
    {
      "description": "Keep base image digest refreshes to one PR per repository.",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["pin", "pinDigest", "digest"],
      "groupName": "docker base image digests"
    },
    {
      "description": "A pin changes no code and has no release date, so the release age check would hold it forever.",
      "matchUpdateTypes": ["pin", "pinDigest"],
      "minimumReleaseAge": null
    }
  ],
  "schedule": ["* * * * 1"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* * * * 1"]
  },
  "minimumReleaseAge": "7 days",
  "constraints": {
    "npm": "^11"
  },
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"],
    "rebaseWhen": "behind-base-branch"
  }
}

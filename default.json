{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Appwrite shared Renovate preset. Renovate owns dependency PRs; Dependabot only raises alerts.",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "group:allNonMajor",
    ":semanticCommits"
  ],
  "labels": ["dependencies"],
  "schedule": ["* * * * 1"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* * * * 1"]
  },
  "minimumReleaseAge": "7 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"]
  }
}
